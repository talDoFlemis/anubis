{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1",
    "^@/(.*)$": "<rootDir>/../src/$1",
    "^@database/(.*)$": "<rootDir>/../src/database/$1",
    "^@users/(.*)$": "<rootDir>/../src/users/$1",
    "^@professors/(.*)$": "<rootDir>/../src/professors/$1"
  }
}
